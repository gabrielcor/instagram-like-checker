# The checker is deliberately restricted to this one Instagram account.
TARGET_USERNAME=michelle.apostolowski

# Scheduled checks inspect only the newest posts. A full audit uses FULL_AUDIT_LIMIT.
CHECK_LIMIT=12
FULL_AUDIT_LIMIT=250
HEADLESS=true
MIN_POST_DELAY_MS=4500
MAX_POST_DELAY_MS=8000
MIN_SCROLL_DELAY_MS=2500
MAX_SCROLL_DELAY_MS=4500

# Set to 0 to notify only once for each continuously-unliked post.
# If a post becomes liked and is later unliked, it is considered new again.
REMINDER_DAYS=0
NOTIFY_ON_ALL_CLEAR=false

# SMTP example for Gmail. Use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-an-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Optional. Separate multiple addresses with commas.
EMAIL_CC=
